# ==============================================================================
# Environment Configuration Template
# COPY TO .env AND FILL WITH REAL VALUES - NEVER COMMIT .env TO GIT
# ==============================================================================

# General Environment
ENVIRONMENT=development
LOG_LEVEL=Information

# ASP.NET Core & Security
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://+:7001;http://+:5001
JWT_SECRET_KEY=replace_with_a_secure_minimum_32_character_key_here
JWT_ISSUER=StockAssistantAPI
JWT_AUDIENCE=StockAssistantClient
JWT_EXPIRE_MINUTES=60

# Database: Microsoft SQL Server
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_DB=StockAssistantDb
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=YourStrong@Passw0rd!
CONNECTION_STRING=Server=localhost,1433;Database=StockAssistantDb;User Id=sa;Password=YourStrong@Passw0rd!;TrustServerCertificate=True;

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CONNECTION_STRING=localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Python Analysis Engine Service
PYTHON_ANALYSIS_SERVICE_URL=http://localhost:8000

# Market Data API Providers (Choose and configure)
# Options: AlphaVantage, TwelveData, Mock
ACTIVE_MARKET_DATA_PROVIDER=Mock
ALPHA_VANTAGE_API_KEY=your_alphavantage_key_here
TWELVE_DATA_API_KEY=your_twelvedata_key_here
FINNHUB_API_KEY=your_finnhub_key_here

# AI / LLM Integration
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
